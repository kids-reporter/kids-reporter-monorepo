# Keystone CMS Environment Variables
# Copy this file to .env.local and update the values as needed

# Database Configuration
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgres://user:password@localhost:5432/kids

# Session Configuration
SESSION_SECRET=your_session_secret_should_be_more_than_32_characters_long
SESSION_MAX_AGE=86400

# UI Configuration
IS_UI_DISABLED=false

# Preview Server Configuration
PREVIEW_SERVER_ORIGIN=http://localhost:3001
PREVIEW_SERVER_PATH=/preview-server

# Google Cloud Storage Configuration
GCS_ORIGIN=http://localhost:3000

# File Storage Configuration
FILES_BASE_URL=/files
FILES_STORAGE_PATH=public/files

# Image Storage Configuration
IMAGES_BASE_URL=/images
IMAGES_STORAGE_PATH=public/images

# Memory Cache Configuration
MEMORY_CACHE_TTL=300000
MEMORY_CACHE_SIZE=300

# CORS Configuration
CORS_ALLOW_ORIGINS=https://kids.twreporter.org,https://next-kids.twreporter.org

# Two-Factor Authentication Configuration
TWO_FACTOR_AUTH_ENABLE=false
TWO_FACTOR_AUTH_SECRET=your_2fa_secret_should_be_more_than_32_characters_long
TWO_FACTOR_AUTH_COOKIE_NAME=keystonejs-2fa
TWO_FACTOR_AUTH_SERVICE_NAME=KidsReporter Keystone

# External Service Configuration
TWREPORTER_ID=twreporter-id
SEARCH_API_KEY=search-api-key
OPEN_AI_KEY=open-ai-key
OPEN_AI_ORGANIZATION=open-ai-organization
OPEN_AI_PROJECT=open-ai-project

# JWT Configuration for Go API
GO_API_JWT_SECRET=your_jwt_secret_here
GO_API_JWT_ISSUER=https://go-api.twreporter.org
GO_API_JWT_AUDIENCE=https://www.twreporter.org

# Environment, set to 'test' to disable auth in local development
NODE_ENV=development
