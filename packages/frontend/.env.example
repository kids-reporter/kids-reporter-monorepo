# Graphql Endpoint
INTERNAL_GQL_ENDPOINT=http://localhost:3000/api/graphql
NEXT_PUBLIC_GQL_ENDPOINT=http://localhost:3000/api/graphql

# API Gateway Endpoint
INTERNAL_API_GATEWAY_ENDPOINT=http://localhost:3000
NEXT_PUBLIC_API_GATEWAY_ENDPOINT=http://localhost:3000

# Content API Endpoint
INTERNAL_CONTENT_API_ENDPOINT=http://localhost:8081
NEXT_PUBLIC_CONTENT_API_ENDPOINT=http://localhost:8081

# Mock id_token
MOCK_ID_TOKEN=

# Release Env
NEXT_PUBLIC_RELEASE_ENV=

# Google Search
SEARCH_API_KEY=search-api-key
SEARCH_ENGINE_ID=search-engine-id

# Login Url
NEXT_PUBLIC_LOGIN_URL=/login

# Login Widget Url
NEXT_PUBLIC_LOGIN_WIDGET_URL=https://accounts.twreporter.org/signin-widget

# Baodaozai Rive File Url
NEXT_PUBLIC_BAODAOZAI_RIVE_FILE_PATH=https://kids-storage.twreporter.org/callinbaodaozai.riv

# Deployment ID (injected at build time via Cloud Build SHORT_SHA; used by Next.js to detect deployment skew)
DEPLOYMENT_ID=

# Server Actions (set in Cloud Run environment variables, not in .env.local)
# Used to encrypt/decrypt Server Actions payloads; must be identical across all instances in a deployment.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Request Timeout MS
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000

# Use Content API (feature toggle)
NEXT_PUBLIC_USE_CONTENT_API=true
