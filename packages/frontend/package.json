{
  "name": "@kids-reporter/frontend",
  "version": "1.0.10",
  "private": true,
  "scripts": {
    "dev": "concurrently \"yarn codegen:local --watch\" \"next dev --port ${PORT:-3000}\"",
    "build": "yarn build:local",
    "build:local": "yarn codegen:local && next build",
    "build:cloudbuild": "yarn codegen:cloudbuild && next build",
    "start": "next start",
    "analyze": "ANALYZE=true yarn build:local",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "codegen:local": "graphql-codegen --config codegen.local.ts",
    "codegen:cloudbuild": "graphql-codegen --config codegen.cloudbuild.ts",
    "postinstall": "yarn codegen:local && yarn workspace @kids-reporter/logger build && yarn workspace @kids-reporter/routing-ui build"
  },
  "dependencies": {
    "@googleapis/customsearch": "^1.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@kids-reporter/draft-renderer": "^1.0.13",
    "@kids-reporter/logger": "^0.0.2",
    "@kids-reporter/routing-ui": "0.1.22",
    "@next/third-parties": "^14.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@rive-app/react-webgl2": "^4.23.4",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@twreporter/errors": "^1.1.2",
    "@types/draft-js": "^0.11.10",
    "@types/node": "20.19.17",
    "@types/react-dom": "18.3.7",
    "@types/react-helmet": "^6.1.7",
    "@types/react-transition-group": "^4.4.6",
    "@types/styled-components": "^5.1.34",
    "axios": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "draft-js": "^0.11.7",
    "encoding": "^0.1.13",
    "graphql-tag": "^2.12.6",
    "lodash": "^4.17.21",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-helmet": "^6.1.0",
    "react-hook-form": "7.66.0",
    "react-loading-skeleton": "^3.3.1",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "styled-components": "6.1.19",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "zod": "^4.1.12",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@next/bundle-analyzer": "^14.2.33",
    "@next/eslint-plugin-next": "^14.2.33",
    "@parcel/watcher": "^2.5.1",
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.7",
    "concurrently": "^9.1.2",
    "graphql": "^16.8.1",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
