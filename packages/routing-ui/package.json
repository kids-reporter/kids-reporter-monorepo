    "@babel/preset-react": "^7.17.12",
    "@babel/preset-typescript": "^7.17.12",
    "@babel/runtime": "^7.18.5",
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.7",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
