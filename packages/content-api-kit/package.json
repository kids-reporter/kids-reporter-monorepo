{
  "name": "@kids-reporter/content-api-kit",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Reusable Express app kit for Kids Reporter content APIs",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth/go-api-jwt": {
      "types": "./dist/auth/go-api-jwt.d.ts",
      "import": "./dist/auth/go-api-jwt.js",
      "default": "./dist/auth/go-api-jwt.js"
    }
  },
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint:check": "eslint src --config ./eslint.config.mjs --ext .ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.12"
  },
  "dependencies": {
    "@babel/runtime": "^7.18.5",
    "@kids-reporter/logger": "^0.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.5",
    "@babel/core": "^7.18.5",
    "@babel/plugin-transform-runtime": "^7.18.5",
    "@babel/preset-env": "^7.18.2",
    "@babel/preset-typescript": "^7.17.12",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.6",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
