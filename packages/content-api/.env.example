# Content API Environment Variables
# Copy this file to .env.local and update values as needed.

PORT=8081
CORS_ALLOW_ORIGINS=http://localhost:3001
GO_API_ENV=staging
GCS_ORIGIN=https://kids-storage.twreporter.org
GCP_PROJECT_ID=kids-reporter
GO_API_JWT_SECRET=
GO_API_JWT_ISSUER=
GO_API_JWT_AUDIENCE=
IMAGES_STORAGE_PATH=public/images
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgres://user:password@localhost:5432/kids

# Optional
REQUEST_TIMEOUT_MS=10000

# Preview-only content-api (internal Cloud Run). When true, GET /v1/posts/*
# returns draft/unpublished posts. Do not set on public content-api.
IS_PREVIEW_SERVER=false

# Preview deployment (GCP, not local dev):
# - Deploy a separate internal content-api service with IS_PREVIEW_SERVER=true
# - Point preview frontend INTERNAL_CONTENT_API_ENDPOINT at that service (SSR/RSC)
# - Keep NEXT_PUBLIC_CONTENT_API_ENDPOINT on the public content-api URL for browser calls
